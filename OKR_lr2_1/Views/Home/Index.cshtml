@{
    ViewData["Title"] = "Калькулятор";

    var initialDisplay = "0";
    if (ViewBag.Result != null)
    {
        if (ViewBag.Result is string)
        {
            initialDisplay = "0";
        }
        else
        {
            initialDisplay = ViewBag.Result.IsError ? "Помилка" : ViewBag.Result.Result.ToString();
        }
    }

    // Якщо було викликано пам'ять, показуємо її
    if (ViewBag.MemoryValue != null)
    {
        initialDisplay = ViewBag.MemoryValue.ToString();
    }
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <input type="hidden" id="serverResult" value="@initialDisplay" />

    <div class="calculator-case">
        <header class="display-panel">
            <div class="panel-header">
                <span class="brand">SHARP</span>
                <div class="solar-cell">
                    <span></span><span></span><span></span><span></span>
                </div>
            </div>

            <div class="lcd-screen">
                <div class="lcd-indicators">
                    <span class="ind-step">01</span>
                    <span class="ind-icon" style="opacity: @(ViewBag.MemoryValue != null || ViewBag.MemoryState == "Cleared" ? "1" : "0.1")">M</span>
                    <span class="ind-icon">+TAX</span>
                </div>
                <div class="lcd-digits" id="display">0.0</div>
            </div>

            <div class="model-name">ELSI MATE EL-128C</div>
        </header>

        <main class="keypad-body">
            <div class="keypad-grid">
                <!-- РЯДОК 1 -->
                <button class="btn btn-light" data-val="prev">PREV ▲</button>
                <button class="btn btn-light text-green" data-val="auto-replay">AUTO<br>REPLAY</button>
                <button class="btn btn-light" data-val="(">(</button>
                <button class="btn btn-light" data-val=")">)</button>
                <div class="empty-cell"></div>

                <!-- РЯДОК 2 -->
                <button class="btn btn-light" data-val="next">NEXT ▼</button>
                <button class="btn btn-light text-green" data-val="correct">CORRECT</button>
                <button class="btn btn-light text-orange labeled-btn" data-val="tax-plus">
                    <span class="sub-label">RATE SET</span>+TAX
                </button>
                <button class="btn btn-light text-orange labeled-btn" data-val="tax-minus">
                    <span class="sub-label">RATE RECALL</span>−TAX
                </button>

                <form asp-controller="Home" asp-action="ClearAll" method="post" style="display: contents;">
                    <button type="submit" class="btn btn-light" data-val="CA">CA</button>
                </form>

                <!-- РЯДОК 3 -->
                <form asp-controller="Home" asp-action="RecallClearMemory" method="get" style="display: contents;">
                    <button type="submit" class="btn btn-light" data-val="R-CM">R•CM</button>
                </form>

                <form asp-controller="Home" asp-action="MemoryMinus" method="post" style="display: contents;">
                    <input type="hidden" name="value" class="hidden-value" />
                    <button type="submit" class="btn btn-light" data-val="M-">M−</button>
                </form>

                <form asp-controller="Home" asp-action="MemoryPlus" method="post" style="display: contents;">
                    <input type="hidden" name="value" class="hidden-value" />
                    <button type="submit" class="btn btn-light" data-val="M+">M+</button>
                </form>

                <button class="btn btn-light" data-val="rate">RATE</button>
                <button class="btn btn-red labeled-btn" data-val="CE">
                    <span class="sub-label">ON</span>CE
                </button>

                <!-- РЯДОК 4 -->
                <button class="btn btn-dark" data-val="7">7</button>
                <button class="btn btn-dark" data-val="8">8</button>
                <button class="btn btn-dark" data-val="9">9</button>
                <button class="btn btn-light" data-val="%">%</button>
                <button class="btn btn-light" data-val="backspace">→</button>

                <!-- РЯДОК 5 -->
                <button class="btn btn-dark" data-val="4">4</button>
                <button class="btn btn-dark" data-val="5">5</button>
                <button class="btn btn-dark" data-val="6">6</button>
                <button class="btn btn-light" data-val="*">×</button>
                <button class="btn btn-light" data-val="/">÷</button>

                <!-- РЯДОК 6 -->
                <button class="btn btn-dark" data-val="1">1</button>
                <button class="btn btn-dark" data-val="2">2</button>
                <button class="btn btn-dark" data-val="3">3</button>
                <button class="btn btn-light btn-tall-plus" data-val="+">+</button>
                <button class="btn btn-light" data-val="-">−</button>

                <!-- РЯДОК 7 -->
                <button class="btn btn-dark" data-val="0">0</button>
                <button class="btn btn-dark" data-val="00">00</button>
                <button class="btn btn-dark" data-val=".">.</button>

                <!-- Форма обчислення = -->
                <form asp-controller="Home" asp-action="Calculate" method="get" id="calcForm" style="display: contents;">
                    <input type="hidden" name="expression" id="hiddenExpression" />
                    <button type="submit" class="btn btn-light" data-val="=">=</button>
                </form>
            </div>
        </main>
    </div>
    <script src="~/js/site.js"></script>
</body>
</html>